NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/phishx

CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://127.0.0.1:8010
ML_REQUEST_TIMEOUT_MS=5000
ML_STRICT_MODE=false

JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

ADMIN_EMAIL=admin@phishx.local
ADMIN_PASSWORD=ChangeMeStrong123!

RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100

CSRF_ENABLED=false
CSRF_SHARED_TOKEN=

SSL_SKIP_DEV_CHECK=true
SSL_CHECK_TIMEOUT_MS=5000
SSL_MAX_REDIRECTS=5

RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_HOURS=24
HEALTH_EMIT_INTERVAL_MS=30000

HTTPS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=
