NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/phishx
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
HEALTH_EMIT_INTERVAL_MS=30000
ADMIN_EMAIL=admin@phishx.local
ADMIN_PASSWORD=ChangeMeStrong123!
THRESHOLD_SUSPICIOUS=40
THRESHOLD_PHISHING=70
RETENTION_DAYS=90
RETENTION_CLEANUP_INTERVAL_HOURS=24
HTTPS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=
CSRF_ENABLED=false
CSRF_SHARED_TOKEN=change_me_shared_csrf_token
SSL_CHECK_TIMEOUT_MS=2000
